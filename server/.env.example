# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
# For testing, you can use Railway's PostgreSQL or local PostgreSQL
# Example: postgresql://user:password@localhost:5432/timetrack
DATABASE_URL="postgresql://postgres:password@localhost:5432/timetrack"

# JWT Authentication
# Generate a secure random secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN=24h

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
